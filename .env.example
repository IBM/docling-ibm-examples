# Docling for IBM watsonx: copy these from the Workbench -> API examples.
# Copy this file to .env (never commit .env).
DOCLING_SERVICE_URL=https://api.example.dcls.saas.ibm.com/your-instance-id
DOCLING_SERVICE_API_KEY=your-api-key

# watsonx.ai, used by the RAG examples
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_APIKEY=your-ibm-cloud-api-key
WATSONX_PROJECT_ID=your-watsonx-project-id
