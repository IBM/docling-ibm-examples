# Credentials
.env
.env.*
!.env.example
api-key-*.txt
*.pem

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.ipynb_checkpoints/
dist/
uv.lock

# Java
target/
.tools/

# Terraform. The state holds every secret the keys and connections were made
# with, so it stays on this machine. The lock files pin the providers and are
# committed.
.terraform/
*.tfstate
*.tfstate.*
crash.log

# Outputs written by the examples
output/
converted/
/05-confluent-cloud/examples/04-invoice-extraction/udf/src/invoice_udf/_truth.py
/05-confluent-cloud/examples/04-invoice-extraction/data/extractions/
/05-confluent-cloud/examples/04-invoice-extraction/data/dataset/

# Binary media and documents, in example 05 and the top-level docs. The invoice
# PDFs are in a public Hugging Face bucket: see the README in
# 05-confluent-cloud/examples/04-invoice-extraction.
/05-confluent-cloud/**/*.pdf
/05-confluent-cloud/**/*.jpg
/05-confluent-cloud/**/*.jpeg
