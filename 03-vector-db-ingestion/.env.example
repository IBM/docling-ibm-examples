# Settings for 03-vector-db-ingestion. The Docling credentials
# (DOCLING_SERVICE_URL, DOCLING_SERVICE_API_KEY) come from the repository root .env.
# Copy this file to .env in this folder (never commit .env).

# AstraDB (Serverless, vector): database -> Overview
ASTRA_DB_API_ENDPOINT=https://your-database-id-your-region.apps.astra.datastax.com
ASTRA_DB_TOKEN=AstraCS:your-token
ASTRA_DB_COLLECTION=docling_chunks
