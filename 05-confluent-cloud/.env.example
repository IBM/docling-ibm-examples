# Settings for python/send.py. The Docling credentials (DOCLING_SERVICE_URL,
# DOCLING_SERVICE_API_KEY) come from the repository root .env.
# Copy this file to .env in this folder (never commit .env).

# Confluent Cloud: cluster -> Cluster settings -> Endpoints
KAFKA_BOOTSTRAP_SERVER=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
# Confluent Cloud: cluster -> API keys -> Add key
KAFKA_API_KEY=your-kafka-api-key
KAFKA_API_SECRET=your-kafka-api-secret
KAFKA_TOPIC=docling_chunks
