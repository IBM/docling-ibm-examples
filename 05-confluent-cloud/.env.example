# 05-confluent-cloud — your account.
#
# **You fill in three values by hand. Terraform makes the rest.**
#
#     cp .env.example .env
#     # edit: CONFLUENT_CLOUD_API_KEY, CONFLUENT_CLOUD_API_SECRET, NS
#     ./account.sh plan         # what terraform/account would make
#     ./account.sh apply        # cluster, pool, keys in "default" -> .env
#     ./account.sh check        # confirms all of it works
#
# Everything marked [auto] below is written by `./account.sh apply`, so leave
# it alone. On an account you share, set the ids in section 2 to what is
# already there, and `apply` uses those instead of making its own.
#
# This file is the *account*. What each example calls its topics, views,
# functions and artifacts is in `examples/<n>/env.sh` — committed, derived from
# NS below, and yours to read before you run anything. What an example's setup
# applies for itself (chiefly artifact ids) lands in `examples/<n>/.env`,
# which is generated and gitignored. The Terraform state beside each — which
# holds every secret below — is gitignored too.
#
# .env is gitignored. Keep it that way.

# ---------------------------------------------------------------------------
# 1. Credentials — the one you make, and the ones made from it.
# ---------------------------------------------------------------------------

# A **Cloud** API key: console -> your account menu -> API keys -> Add key ->
# "Cloud resource management", for *My account*. It is what Terraform runs as:
# it makes the cluster, the pool and the service account, mints the other keys,
# and uploads the UDF artifacts.
#
# It can do what its owner can. To make all of that it needs
# **OrganizationAdmin** — which the owner of a new account has. With
# CC_PRINCIPAL_ID set to the key's own owner (section 2), EnvironmentAdmin plus
# FlinkAdmin on the environment is enough: only the service account and
# GLOBAL_KEY need more. The README's "Getting the Cloud API key" has the steps. A key whose owner has no role bindings at all authenticates fine and
# then sees *zero* environments; `./account.sh check` says so.
CONFLUENT_CLOUD_API_KEY=""
CONFLUENT_CLOUD_API_SECRET=""

# [auto] A **Flink** API key, scoped to one environment and region. The only
# key that can submit a statement; the Cloud key cannot.
FLINK_API_KEY=""
FLINK_API_SECRET=""

# [auto] A **Kafka cluster** API key. Used by the examples' scripts/ and
# example 03's connector only: producing records, draining a topic. The Flink
# statements never see it, because Flink reads and writes the topics as itself.
KAFKA_API_KEY=""
KAFKA_API_SECRET=""
KAFKA_BOOTSTRAP_SERVERS=""

# [auto, when the environment has a Schema Registry — Stream Governance on]
# Examples 04 and 05 only: their topics carry registered JSON Schemas, and their
# scripts produce and consume through them.
SCHEMA_REGISTRY_ID=""
SCHEMA_REGISTRY_URL=""
SCHEMA_REGISTRY_API_KEY=""
SCHEMA_REGISTRY_API_SECRET=""

# [auto, with GLOBAL_KEY="yes"] Example 04 only: a *global* API key, which is
# what the Real-Time Context Engine's MCP endpoint accepts. Opt-in, because it
# authenticates to everything the principal may use, and a principal may hold
# at most two. Minting one takes an OrganizationAdmin's Cloud key.
GLOBAL_KEY="no"
RTCE_API_KEY=""
RTCE_API_SECRET=""

# ---------------------------------------------------------------------------
# 2. Where. Each of these is *either* yours to set *or* [auto].
#
# The environment is never made: unset, it is the account's "default". The
# rest, unset, `apply` makes — named "<NS>-docling" — and writes its id here;
# it is then Terraform's, and `./account.sh destroy` deletes it again — a
# cluster with every topic in it. Set, it is only looked up: Terraform never
# creates or destroys it. Each id is in the console URL when you open the
# thing, and `./account.sh check` lists every one this key can see.
# ---------------------------------------------------------------------------

CC_ENVIRONMENT_ID=""    # env-xxxxxx — unset: the environment called "default"
CC_CLUSTER_ID=""        # lkc-xxxxxx — made Basic, single-zone, in CC_CLOUD/CC_REGION
CC_COMPUTE_POOL_ID=""   # lfcp-xxxxxx — Flink's compute, billed separately from the cluster
CC_POOL_MAX_CFU="10"    # the ceiling of a pool `apply` makes; it scales to zero when idle

# Who owns the keys, and so who the Flink statements run as. Unset: a service
# account, with EnvironmentAdmin and FlinkAdmin on the environment. Set it to
# a user (u-xxxxxx) or service account (sa-xxxxxx) that already has them.
CC_PRINCIPAL_ID=""

# Where a cluster `apply` makes goes. For a given cluster, `apply` reads its
# own cloud and region and writes them here. The compute pool and the Flink
# key are always in the cluster's: a pool in another region cannot read its
# topics.
CC_CLOUD="aws"
CC_REGION="us-east-1"

# [auto]
CC_ORG_ID=""            # 00000000-0000-0000-0000-000000000000

# [auto] What a bare table name resolves against, and these are **display
# names**, not ids: the catalog is the environment's name and the database is
# the cluster's, both exactly as written in the console. Putting env-xxxxxx /
# lkc-xxxxxx here is the classic first failure — it parses, and then nothing
# resolves. In a Flink SQL workspace: SHOW CATALOGS; SHOW DATABASES;
CC_CATALOG=""
CC_DATABASE=""

# ---------------------------------------------------------------------------
# 3. Your namespace. Read this one before the rest.
# ---------------------------------------------------------------------------
#
# Nothing this repo creates is private. A Flink catalog IS a Confluent
# environment and a Flink database IS a Kafka cluster, so every table, view and
# function any example creates is visible to — and collide-able with —
# everyone who can see that environment. There is no per-user schema to hide in.
#
# So everything is named from NS, because the collisions that matter are
# silent. Two pipelines sharing an output topic interleave results nobody can
# then find; two sharing a consumer group split the partitions and each sees
# half the data, from a job that looks perfectly healthy.
#
# Use something nobody else in this environment will pick — your initials, a
# ticket number, a team name. Then run an example's `./setup.sh info` and make
# sure you recognise every name it prints as yours.
NS=""

# ---------------------------------------------------------------------------
# 4. Docling for IBM watsonx — examples 02, 03, 04 and 05.
# ---------------------------------------------------------------------------
#
# Example 01 runs Docling on your own machine and needs neither of these.
# Examples 02 to 05 call the SaaS from inside a Flink statement, through a
# Flink CONNECTION that this repo creates from these two values — so the secret
# ends up held by Confluent Cloud, not pasted into a statement.
#
# Both come from the Docling for IBM watsonx client: Service URL and API key.
# The URL looks like https://api.<something>.dcls.saas.ibm.com/<instance-id>
# and is used whole, as the base of every request.
#
# A self-hosted docling-serve works here too, as long as it is reachable from
# Confluent Cloud's egress in CC_CLOUD/CC_REGION — i.e. publicly routable.
# Leave DOCLING_API_KEY empty for a docling-serve that wants no key.
DOCLING_SERVICE_URL=""
DOCLING_API_KEY=""

# Example 04 only: where Docling fetches the invoice PDFs for a *real*
# extraction (chosen per release on its dashboard; *synthetic* needs none of
# this) — a private Hugging Face Storage Bucket, handed out as signed URLs that
# live one hour. The Hub token is read from HF_TOKEN or from `hf auth login`;
# it never leaves your machine.
# INVOICE_BUCKET="docling-project/docling-confluent-ex04"

# Example 05 only: who you are, for SEC EDGAR. The SEC's Fair Access Policy
# wants every client to identify itself ("Name <email>"), and answers 403 to a
# request without a User-Agent. sec_producer.py sends it to the SEC, and the
# pipeline hands it to Docling for IBM watsonx, which fetches each filing itself.
# Unset, example 05 uses a placeholder: set your own before you produce.
# SEC_USER_AGENT="Your Name you@example.com"
# SEC_FORM_TYPE="10-K,10-Q"       # which forms the producer follows

# ---------------------------------------------------------------------------
# 5. Sizing. Shared by every example.
# ---------------------------------------------------------------------------

# One partition per topic. Confluent Cloud's default is 6, and for a workload
# of a few hundred chunks that buys nothing: a partition is the unit of
# parallelism, and these pipelines' only shuffle is the dedup key. It also makes
# the output *readable* — with one partition the enriched topic is in the order
# it was produced, which is what you want when comparing it against the input
# by eye. Raise it when the volume justifies it, not before.
PARTITIONS="1"

# How long the topics keep data. Worth setting explicitly, because Flink's
# `kafka.retention.time` defaults to **0, which means infinite** — an
# experiment you ran once would otherwise keep paying storage for its output
# forever. A Flink duration ('1 d', '12 h', '30 min');
# converts it to retention.ms for the topics it creates itself.
RETENTION="1 d"

# Not configurable, and not an omission: Confluent Cloud replicates every topic
# three ways and neither the API nor CREATE TABLE lets you ask for less.

# ---------------------------------------------------------------------------
# 6. The enrichment's own knobs. Shared by every example, because every example
#    runs the same enrichment — see common/flink/.
#    These are SQL literals, so booleans must be TRUE or FALSE.
# ---------------------------------------------------------------------------
MIN_CHARS="40"
DROP_LOW_QUALITY="FALSE"
PII_DETECTORS="email,credit_card,iban"   # pii.DEFAULT_ENABLED; phone and
                                         # ip_address are off for a reason
PII_REDACT="TRUE"
BLOCKED_DOC_IDS=""                       # comma-separated; empty is fine

# How long the dedup state remembers a fingerprint, as a Flink duration. This
# is submitted as the `sql.state-ttl` statement property, not as SQL.
DEDUP_TTL="24 h"

# The column a raw record arrives in — `val` either way, because Flink
# *requires* that name for a 'raw' value and an inferred table uses it too. It
# holds BYTES, not text: raw carries bytes and there is no schema to say
# otherwise, so the statements DECODE it to STRING at the source and ENCODE on
# the way out. The knob stays only as the escape hatch for a topic someone
# declared with a different schema.
CHUNKS_VALUE_COLUMN="val"
